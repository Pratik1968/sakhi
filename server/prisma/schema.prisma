// Sakhi backend data model. SQLite for local dev (swap `provider`/`DATABASE_URL`
// for Postgres in production). SQLite has no native enums — status fields are
// strings with the allowed values documented inline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String
  expoPushToken String?
  createdAt     DateTime @default(now())

  // Guardian links owned by this user (people watching over them).
  guardianLinks GuardianLink[] @relation("Owner")
  // Guardian links where this user is the guardian of someone else.
  watchingLinks GuardianLink[] @relation("Guardian")

  locations LocationPing[]
  sosEvents SosEvent[]
  incidents Incident[]
  evidence  Evidence[]
}

// A person in the owner's safety circle. `guardianUserId` is set once the
// invitee has an account; otherwise the invite is tracked via `inviteeContact`.
model GuardianLink {
  id             String   @id @default(cuid())
  ownerId        String
  owner          User     @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  guardianUserId String?
  guardian       User?    @relation("Guardian", fields: [guardianUserId], references: [id])
  inviteeContact String? // email or phone used to invite, before they sign up
  name           String
  // PENDING | ACTIVE | SOS_ONLY | DECLINED
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  @@index([ownerId])
  @@index([guardianUserId])
}

model LocationPing {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  @@index([userId, recordedAt])
}

model SosEvent {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ACTIVE | RESOLVED | CANCELLED
  status     String    @default("ACTIVE")
  lat        Float?
  lng        Float?
  note       String?
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  evidence Evidence[]

  @@index([userId, status])
}

model Incident {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // harassment | unsafe-area | stalking | other
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  evidence Evidence[]

  @@index([userId])
}

model Evidence {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // AUDIO | VIDEO | IMAGE
  kind       String
  url        String
  sosEventId String?
  sosEvent   SosEvent? @relation(fields: [sosEventId], references: [id], onDelete: SetNull)
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([userId])
}
