// Sakhi backend data model. Postgres (local dev via docker-compose `db` service,
// see docker-compose.yml + server/.env). Status fields are strings with the
// allowed values documented inline (kept as strings rather than native enums so
// new statuses can be added without a migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String
  expoPushToken String?
  createdAt     DateTime @default(now())

  // Guardian links owned by this user (people watching over them).
  guardianLinks GuardianLink[] @relation("Owner")
  // Guardian links where this user is the guardian of someone else.
  watchingLinks GuardianLink[] @relation("Guardian")

  locations LocationPing[]
  sosEvents SosEvent[]
  incidents Incident[]
  evidence  Evidence[]
}

// A person in the owner's safety circle. `guardianUserId` is set once the
// invitee has an account; otherwise the invite is tracked via `inviteeContact`.
model GuardianLink {
  id             String   @id @default(cuid())
  ownerId        String
  owner          User     @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  guardianUserId String?
  guardian       User?    @relation("Guardian", fields: [guardianUserId], references: [id])
  inviteeContact String? // email or phone used to invite, before they sign up
  name           String
  relationship   String? // optional label e.g. Sister | Flatmate | Family
  // PENDING | ACTIVE | SOS_ONLY | DECLINED
  status         String   @default("PENDING")
  // Intended watch mode (ACTIVE | SOS_ONLY) remembered while the link is PENDING,
  // applied to both directions once the invitee accepts.
  watchMode      String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  @@index([ownerId])
  @@index([guardianUserId])
}

model LocationPing {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  @@index([userId, recordedAt])
}

model SosEvent {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ACTIVE | RESOLVED | CANCELLED
  status     String    @default("ACTIVE")
  lat        Float?
  lng        Float?
  note       String?
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  evidence Evidence[]

  @@index([userId, status])
  @@index([startedAt])
}

model Incident {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // harassment | unsafe-area | stalking | other
  area        String? // human-readable place label for the report location
  description String? // free-text description of what happened
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())

  evidence Evidence[]

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

model Evidence {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // AUDIO | VIDEO | IMAGE
  kind       String
  url        String
  sosEventId String?
  sosEvent   SosEvent? @relation(fields: [sosEventId], references: [id], onDelete: SetNull)
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Geocoded crime-news incidents used by the safe-route planner (Phase 6 of the
// sakhi_model pipeline). Seeded from server/prisma/data/incidents_geo.csv; add
// more rows to that CSV and re-run the crime seed to grow the dataset over time.
// Hyderabad-only, crime-NEWS reporting density (n<5 per locality) — a
// methodology demo, not a safety guarantee.
model CrimeIncident {
  id              String    @id @default(cuid())
  // sexual_offence | assault | homicide | robbery | theft | burglary |
  // narcotics | fraud | cybercrime | traffic_fatality | other | not_crime
  crimeType       String
  locality        String
  incidentDate    DateTime?
  severity        Int // 1–5
  // day | night | unknown
  timeOfDay       String    @default("unknown")
  nArticles       Int       @default(1)
  lat             Float
  lon             Float
  zone            String?
  commissionerate String?
  geoConfidence   Float?
  // Provenance so future non-news sources (police records, user reports) mix in.
  source          String    @default("gdelt-news")
  createdAt       DateTime  @default(now())

  @@index([lat, lon])
  @@index([crimeType])
  @@index([severity])
}

// Static directory of nearby-help places (police stations, hospitals, women's
// support centres) for the "Nearby help" screen. Standalone reference table
// (like CrimeIncident, no FK). Seeded from server/prisma/data/places.csv —
// gathered once from OpenStreetMap Overpass + a curated women-support list.
// Uses `lng` (client/`?lng=` convention), not `lon`.
model NearbyPlace {
  id        String   @id @default(cuid())
  category  String // police | hospital | support
  name      String
  address   String?
  phone     String?
  lat       Float
  lng       Float
  source    String   @default("osm-overpass")
  createdAt DateTime @default(now())

  @@index([category])
  @@index([lat, lng])
}
