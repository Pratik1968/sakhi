# Copy to .env and adjust for your machine.
# Postgres — matches the docker-compose `db` service (user/pass/db all "sakhi").
DATABASE_URL="postgresql://sakhi:sakhi@localhost:5432/sakhi?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
# Comma-separated origins allowed for CORS (Expo web/dev). "*" allows all (dev only).
CORS_ORIGIN="*"
# Self-hosted OSRM (walking profile). Falls back to the public demo server if
# unset — see server/osrm/README.md to build the Hyderabad foot graph locally.
OSRM_URL="http://localhost:5000"
